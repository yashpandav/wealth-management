// Prisma Schema for Wealth Management CRM
// Database: PostgreSQL 15+
//
// Connection Pooling Configuration:
// Add these parameters to DATABASE_URL for optimal performance:
// - connection_limit: Maximum number of connections (recommended: 10-20 for production)
// - pool_timeout: Connection pool timeout in seconds (default: 10)
// - Example: postgresql://user:pass@localhost:5432/db?connection_limit=10&pool_timeout=20

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ====================================
// ENUMS
// ====================================

enum UserRole {
  CLIENT
  RM // Relationship Manager
  ADMIN
  DOCADMIN // Document Administrator for verification workflow
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

enum RequestStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum TransactionType {
  PURCHASE
  WITHDRAWAL // Kept for historical data
  INTEREST_PAYOUT // New - for automated payout transactions
  DIVIDEND
  ADJUSTMENT
}

enum PayoutStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TransactionStatus {
  COMPLETED
  FAILED
  REVERSED
  PENDING_SETTLEMENT
}

enum AuditAction {
  // Authentication
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  MFA_ENABLE
  MFA_DISABLE

  // User management
  USER_CREATE
  USER_UPDATE
  USER_DELETE
  USER_ACTIVATE
  USER_DEACTIVATE

  // Client-RM assignment
  CLIENT_ASSIGN
  CLIENT_REASSIGN

  // Transaction requests
  PURCHASE_REQUEST_CREATE
  PURCHASE_REQUEST_APPROVE
  PURCHASE_REQUEST_REJECT
  PURCHASE_REQUEST_CANCEL
  WITHDRAWAL_REQUEST_CREATE
  WITHDRAWAL_REQUEST_RM_APPROVE
  WITHDRAWAL_REQUEST_RM_REJECT
  WITHDRAWAL_REQUEST_ADMIN_APPROVE
  WITHDRAWAL_REQUEST_ADMIN_REJECT
  WITHDRAWAL_REQUEST_CANCEL

  // Transactions
  TRANSACTION_CREATE
  TRANSACTION_REVERSE
  TRANSACTION_FAIL

  // Document verification
  DOCUMENT_UPLOAD
  DOCUMENT_VERIFY
  DOCUMENT_REJECT
  DOCUMENT_DELETE
  CLIENT_VERIFICATION_STATUS_UPDATE

  // Payout operations
  PAYOUT_SCHEDULE_CREATED
  PAYOUT_CREATED
  PAYOUT_COMPLETED
  PAYOUT_FAILED
  PAYOUT_RECEIPT_UPLOADED

  // Investment management
  INVESTMENT_CREATE
  INVESTMENT_UPDATE
  INVESTMENT_DELETE
  INVESTMENT_OPTION_CREATE
  INVESTMENT_OPTION_UPDATE
  INVESTMENT_OPTION_DELETE

  // Archival
  CLIENT_ARCHIVE
  CLIENT_RESTORE

  // System
  SYSTEM_CONFIG_CHANGE
  DATA_EXPORT
  DATA_IMPORT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ALERT
}

enum NotificationCategory {
  TRANSACTION
  REQUEST
  ASSIGNMENT
  SYSTEM
  PORTFOLIO
  SECURITY
}

enum DocumentType {
  IDENTITY_PROOF // Government ID, Passport, Driver's License
  INVESTMENT_AGREEMENT // Signed investment agreements
  OTHER // Other document types (includes payout receipts)
}

enum LeadSource {
  INSTAGRAM
  YOUTUBE
  FACEBOOK_ADS
  GOOGLE_ADS
  WEBSITE
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW // New lead, not yet contacted
  CONTACTED // RM has contacted the lead
  INTERESTED // Lead showed interest
  NOT_INTERESTED // Lead is not interested
  CONVERTED // Lead converted to registered client
  LOST // Lead lost/dead
}

enum VerificationStatus {
  NOT_SUBMITTED // No documents submitted yet
  PENDING // Documents submitted, awaiting review
  UNDER_REVIEW // Documents are being reviewed
  VERIFIED // All documents verified successfully
  REJECTED // Documents rejected, need resubmission
  EXPIRED // Verification expired, need renewal
}

// ====================================
// CORE USER ENTITIES
// ====================================

/// Base User entity for all user types
model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String // bcrypt hashed
  role     UserRole

  // Personal Information
  firstName String
  lastName  String
  phone     String?

  // Account Status & Security
  status              AccountStatus @default(ACTIVE)
  isActive            Boolean       @default(true)
  emailVerified       Boolean       @default(false)
  failedLoginAttempts Int           @default(0)
  accountLockedUntil  DateTime?
  lastLogin           DateTime?
  lastFailedLogin     DateTime?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Archival (for KYC expired users)
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  // Relationships based on role
  client              Client?
  relationshipManager RelationshipManager?

  // User lead (if user was converted from a lead)
  userLead UserLead?

  // Activity logs
  auditLogs     AuditLog[]
  notifications Notification[]

  // Admin approvals (for transactions)
  approvedTransactions Transaction[] @relation("TransactionApprover")

  // Document verifications (for DOCADMIN and ADMIN roles)
  verifiedDocuments Document[] @relation("DocumentVerifier")

  // Product request completions (for DOCADMIN and ADMIN roles)
  completedProductRequests ProductPurchaseRequest[] @relation("ProductRequestCompleter")

  // Payout processing (for DOCADMIN role)
  processedPayouts Payout[] @relation("PayoutProcessor")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([isArchived])
  @@map("users")
}

/// Client-specific data extending User
model Client {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Assigned Relationship Manager (optional until admin assigns)
  assignedRMId String?
  assignedRM   RelationshipManager? @relation(fields: [assignedRMId], references: [id])

  // Client-specific data
  riskTolerance   String? // LOW, MEDIUM, HIGH
  investmentGoals String? @db.Text
  kycVerified     Boolean @default(false)
  kycDocuments    String? @db.Text // JSON array of document URLs

  // Document verification status
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)

  // Assignment tracking
  assignedAt DateTime @default(now())

  // Archival metadata (for compliance and audit)
  archivedReason String? @db.Text // Reason for archival (e.g., "KYC_EXPIRED_DAY_7")

  // Relationships
  transactions            Transaction[]
  documents               Document[]
  productPurchaseRequests ProductPurchaseRequest[]
  payoutSchedules         PayoutSchedule[]
  payouts                 Payout[]

  @@index([assignedRMId])
  @@index([verificationStatus])
  @@map("clients")
}

/// Relationship Manager specific data extending User
model RelationshipManager {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // RM-specific data
  specialization String? // e.g., "High Net Worth", "Retirement Planning"
  certifications String? @db.Text // JSON array of certifications
  maxClientLimit Int?    @default(50)

  // Performance metrics
  totalAUM Decimal @default(0) @db.Decimal(15, 2) // Assets Under Management

  // Relationships
  assignedClients         Client[]
  processedTransactions   Transaction[]            @relation("RMProcessor")
  productPurchaseRequests ProductPurchaseRequest[]
  assignedLeads           UserLead[]

  @@map("relationship_managers")
}

/// Completed financial transactions
model Transaction {
  id String @id @default(uuid())

  // References
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Transaction details
  type   TransactionType
  status TransactionStatus @default(COMPLETED)

  // Financial amounts (all in base currency)
  amount    Decimal @db.Decimal(15, 2) // Transaction amount
  total     Decimal @db.Decimal(15, 2) // Total transaction value
  fees      Decimal @default(0) @db.Decimal(15, 2) // Transaction fees/commissions
  netAmount Decimal @db.Decimal(15, 2) // Amount after fees

  // Currency (default to base currency)
  currency String @default("AED") @db.VarChar(3)

  // Bank verification
  bankStatementReference String? @db.Text // Reference to bank statement document
  paymentProof           String? @db.Text // Path or reference to payment proof document

  // Processing information
  processedById String?
  processedBy   RelationshipManager? @relation("RMProcessor", fields: [processedById], references: [id])

  // Admin approval (for withdrawals)
  approvedById String?
  approvedBy   User?   @relation("TransactionApprover", fields: [approvedById], references: [id])

  // Payout reference (for interest payout transactions)
  payoutId String? @unique
  payout   Payout?

  // Timestamps
  completedAt DateTime  @default(now()) // When transaction was completed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // Soft delete (for reversed transactions)

  // Notes and metadata
  notes         String? @db.Text
  metadata      String? @db.Text // JSON for additional data
  failureReason String? @db.Text // If status is FAILED

  // Indexes for performance
  @@index([clientId])
  @@index([type])
  @@index([status])
  @@index([completedAt])
  @@index([processedById])
  @@index([createdAt])
  @@map("transactions")
}

/// Comprehensive audit trail for all critical actions
model AuditLog {
  id String @id @default(uuid())

  // User who performed the action (nullable for system-generated actions)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Action details
  action      AuditAction
  description String?     @db.Text // Human-readable description

  // Entity affected by the action
  entityType String @db.VarChar(50) // e.g., "User", "Transaction", "PurchaseRequest"
  entityId   String // ID of the affected entity

  // Change tracking (JSON format)
  oldValues Json? // Previous state before action
  newValues Json? // New state after action

  // Request metadata
  ipAddress String? @db.VarChar(45) // IPv4 or IPv6
  userAgent String? @db.Text // Browser/client info

  // Additional context
  metadata     Json? // Extra contextual data
  severity     String  @default("INFO") @db.VarChar(20) // INFO, WARNING, ERROR, CRITICAL
  success      Boolean @default(true) // Whether action succeeded
  errorMessage String? @db.Text // If action failed

  // Session tracking
  sessionId String? @db.VarChar(100)

  // Timestamps
  createdAt DateTime @default(now())

  // Retention management (for compliance)
  retentionDate DateTime? // Date when log can be archived/deleted

  // Indexes
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([severity])
  @@index([ipAddress])
  @@map("audit_logs")
}

/// In-app notifications for users
model Notification {
  id String @id @default(uuid())

  // Recipient
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification details
  type     NotificationType
  category NotificationCategory
  title    String               @db.VarChar(255)
  message  String               @db.Text

  // Status
  isRead      Boolean   @default(false)
  readAt      DateTime?
  isDismissed Boolean   @default(false)

  // Action link (optional)
  actionUrl  String? @db.VarChar(500) // URL to navigate when clicked
  actionText String? @db.VarChar(100) // Text for action button

  // Related entity (optional)
  entityType String? @db.VarChar(50) // Type of related entity
  entityId   String? // ID of related entity

  // Priority and expiration
  priority  String    @default("NORMAL") @db.VarChar(20) // LOW, NORMAL, HIGH, URGENT
  expiresAt DateTime? // When notification becomes irrelevant

  // Metadata
  metadata Json? // Additional contextual data

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([category])
  @@index([type])
  @@index([expiresAt])
  @@map("notifications")
}

/// Email verification tokens for user registration
model VerificationToken {
  id String @id @default(uuid())

  // User being verified
  email String @db.VarChar(255)

  // Token details
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime

  // Token type
  type String @default("EMAIL_VERIFICATION") @db.VarChar(50) // EMAIL_VERIFICATION, PASSWORD_RESET

  // Usage tracking
  used   Boolean   @default(false)
  usedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@index([type])
  @@map("verification_tokens")
}

/// Documents uploaded by clients for verification
model Document {
  id String @id @default(uuid())

  // Client who uploaded the document
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Document details
  documentType DocumentType
  filePath     String       @db.VarChar(500) // Path to stored document file

  // Verification status
  verificationStatus VerificationStatus @default(PENDING)

  // Verification details (populated when reviewed by DOCADMIN/ADMIN)
  verifiedById String?
  verifiedBy   User?     @relation("DocumentVerifier", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  // Rejection details
  rejectionReason String? @db.Text

  // Document metadata
  fileName    String? @db.VarChar(255) // Original file name
  fileSize    Int? // File size in bytes
  mimeType    String? @db.VarChar(100) // MIME type of the file
  description String? @db.Text // Optional description by client

  // Expiry tracking (for documents that expire)
  expiryDate DateTime?

  // Reverse relations
  productContractRequests ProductPurchaseRequest[] @relation("ProductContract")
  payoutReceipts          Payout[]                 @relation("PayoutReceipt")

  // Timestamps
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Indexes
  @@index([clientId])
  @@index([clientId, documentType]) // Composite index for faster lookup
  @@index([documentType])
  @@index([verificationStatus])
  @@index([verifiedById])
  @@index([uploadedAt])
  @@map("documents")
}

// ====================================
// USER LEADS (Demo Form Submissions)
// ====================================

/// User lead form submissions from public wealth management form
model UserLead {
  id String @id @default(uuid())

  // Personal Information
  firstName   String @db.VarChar(255)
  lastName    String @db.VarChar(255)
  email       String @unique @db.VarChar(255)
  phoneNumber String @db.VarChar(50)

  // Lead Source & RM Reference
  leadSource  LeadSource
  rmReference String?    @db.VarChar(255) // Optional RM name or code reference from user input

  // Lead Status
  status LeadStatus @default(NEW)

  // Assigned Relationship Manager (set by DocAdmin)
  assignedRMId String?
  assignedRM   RelationshipManager? @relation(fields: [assignedRMId], references: [id])

  // Link to registered user (set when lead converts to registered user)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([email])
  @@index([leadSource])
  @@index([status])
  @@index([assignedRMId])
  @@index([createdAt])
  @@map("user_leads")
}

// ====================================
// INVESTMENT PURCHASE REQUEST MODULE
// ====================================

/// Investment Range Categories (Amount-based investment tiers)
model Investment {
  id String @id @default(uuid())

  // Investment range identification
  name        String  @db.VarChar(255) // e.g., "AED 50,000 - 99,999", "AED 500,000 and Above"
  description String? @db.Text

  // Amount range for the investment tier
  minAmount Decimal  @db.Decimal(15, 2) // Minimum investment amount
  maxAmount Decimal? @db.Decimal(15, 2) // Maximum investment amount (null for "and Above")
  currency  String   @default("AED") @db.VarChar(3)

  // Display order
  displayOrder Int @default(0)

  // Status
  isActive Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  options          InvestmentOption[]
  purchaseRequests ProductPurchaseRequest[]

  // Indexes
  @@index([isActive])
  @@index([displayOrder])
  @@map("investments")
}

/// Investment Options (duration, withdrawal frequency, ROI combinations)
model InvestmentOption {
  id String @id @default(uuid())

  // Investment reference
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  // Option details
  duration            String  @db.VarChar(50) // e.g., "1 Year", "2 Years"
  withdrawalFrequency String  @db.VarChar(50) // e.g., "Monthly", "Quarterly"
  roi                 Decimal @db.Decimal(5, 2) // ROI percentage (e.g., 2.00, 3.00, 10.00, 15.00)
  annualReturn        Decimal @db.Decimal(5, 2) // Annual return percentage (e.g., 24.00, 36.00, 60.00)

  // Display order
  displayOrder Int @default(0)

  // Status
  isActive Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  purchaseRequests ProductPurchaseRequest[]

  // Indexes
  @@index([investmentId])
  @@index([isActive])
  @@map("investment_options")
}

/// Investment Purchase Request submitted by clients
model ProductPurchaseRequest {
  id String @id @default(uuid())

  // Tracking number for client reference
  trackingNumber String @unique @db.VarChar(50)

  // Client who submitted the request
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Investment and option selected
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id])

  investmentOptionId String
  investmentOption   InvestmentOption @relation(fields: [investmentOptionId], references: [id])

  // Request details
  amount Decimal       @db.Decimal(15, 2) // Investment amount
  status RequestStatus @default(PENDING)

  // RM assigned at time of request
  assignedRMId String?
  assignedRM   RelationshipManager? @relation(fields: [assignedRMId], references: [id])

  // Processing information
  processedAt DateTime?

  // Payout configuration (selected by RM during approval)
  payoutWindow String? @db.VarChar(10) // "1-15" or "16-30"

  // Contract information (DocAdmin)
  contractDocumentId String?
  contractDocument   Document? @relation("ProductContract", fields: [contractDocumentId], references: [id])
  contractStartDate  DateTime? // Auto-set to completion date

  // Completion information (DocAdmin)
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("ProductRequestCompleter", fields: [completedById], references: [id])

  // Notes
  clientNotes     String? @db.Text
  rmNotes         String? @db.Text
  rejectionReason String? @db.Text

  // Payout relations
  payoutSchedules PayoutSchedule[]
  payouts         Payout[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([clientId])
  @@index([investmentId])
  @@index([investmentOptionId])
  @@index([assignedRMId])
  @@index([status])
  @@index([createdAt])
  @@index([contractDocumentId])
  @@map("investment_purchase_requests")
}

// ====================================
// PAYOUT & INTEREST DISTRIBUTION SYSTEM
// ====================================

/// Payout Schedule - Auto-generated schedule for contract payouts
model PayoutSchedule {
  id String @id @default(uuid())

  // References
  productPurchaseRequestId String
  productPurchaseRequest   ProductPurchaseRequest @relation(fields: [productPurchaseRequestId], references: [id], onDelete: Cascade)
  clientId                 String
  client                   Client                 @relation(fields: [clientId], references: [id])

  // Schedule details
  scheduledDate  DateTime // Date when payout should be executed
  periodStart    DateTime // Start of the interest calculation period
  periodEnd      DateTime // End of the interest calculation period
  interestAmount Decimal  @db.Decimal(15, 2) // Calculated interest for this period

  // Status
  isProcessed Boolean @default(false) // True when Payout record is created

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  payout Payout? // One-to-one with Payout when processed

  @@unique([productPurchaseRequestId, scheduledDate])
  @@index([productPurchaseRequestId])
  @@index([clientId])
  @@index([scheduledDate])
  @@index([isProcessed])
  @@map("payout_schedules")
}

/// Payout - Actual payout execution record (DocAdmin processed)
model Payout {
  id String @id @default(uuid())

  // References
  productPurchaseRequestId String
  productPurchaseRequest   ProductPurchaseRequest @relation(fields: [productPurchaseRequestId], references: [id])

  payoutScheduleId String         @unique
  payoutSchedule   PayoutSchedule @relation(fields: [payoutScheduleId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Payout details
  amount        Decimal  @db.Decimal(15, 2) // Interest amount to be paid
  periodStart   DateTime // Period start date
  periodEnd     DateTime // Period end date
  scheduledDate DateTime // Original scheduled date

  // Status
  status PayoutStatus @default(PENDING)

  // Processing (DocAdmin only)
  processedById String?
  processedBy   User?     @relation("PayoutProcessor", fields: [processedById], references: [id])
  processedAt   DateTime? // When DocAdmin marked as completed

  // Receipt
  receiptDocumentId String?   @unique
  receiptDocument   Document? @relation("PayoutReceipt", fields: [receiptDocumentId], references: [id])

  // Transaction reference (created when payout is completed)
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  // Notes
  notes String? @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productPurchaseRequestId])
  @@index([clientId])
  @@index([status])
  @@index([scheduledDate])
  @@index([processedById])
  @@map("payouts")
}
