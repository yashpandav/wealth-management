# ====================================
# Wealth Management CRM - Environment Variables
# ====================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# ====================================
# Database Configuration (REQUIRED)
# ====================================
# PostgreSQL connection string with connection pooling
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=X&pool_timeout=Y
# Connection pooling parameters (recommended for production):
# - connection_limit: Max connections (10-20 for production)
# - pool_timeout: Pool timeout in seconds (default: 10)
# Development (without pooling):
DATABASE_URL="postgresql://postgres:password@localhost:5432/fintech"
# Production (with pooling - uncomment and adjust):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/fintech?connection_limit=10&pool_timeout=20"

# ====================================
# NextAuth Configuration (REQUIRED)
# ====================================
# Base URL of your application
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Secret key for encrypting tokens and sessions
# Generate with: openssl rand -base64 32
# IMPORTANT: Use a strong random value in production
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# ====================================
# Email Configuration (REQUIRED for production)
# ====================================
# SMTP server configuration for sending emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-email-password-or-app-password"
SMTP_FROM="noreply@yourcompany.com"

# Email service provider (alternative to SMTP)
# Uncomment if using a service like Resend
# RESEND_API_KEY="re_..."

# ====================================
# Application Configuration (OPTIONAL)
# ====================================
# Node environment
NODE_ENV="development"

# Application name
APP_NAME="Wealth Management CRM"

# Application URL (used in emails and links)
APP_URL="http://localhost:3000"

# ====================================
# Security Configuration (OPTIONAL)
# ====================================
# JWT token expiration (in seconds)
# Default: 1800 (30 minutes)
JWT_EXPIRATION="1800"

# Bcrypt rounds for password hashing
# Default: 12 (recommended for production)
BCRYPT_ROUNDS="12"

# Maximum login attempts before account lockout
# Default: 5
MAX_LOGIN_ATTEMPTS="5"

# Account lockout duration (in minutes)
# Default: 30
LOCKOUT_DURATION="30"

# ====================================
# File Upload Configuration (OPTIONAL)
# ====================================
# Maximum file upload size (in MB)
# Default: 10
MAX_FILE_SIZE="10"

# Allowed file types for uploads (comma-separated)
ALLOWED_FILE_TYPES="pdf,jpg,jpeg,png,doc,docx"

# File storage location
# Options: local, s3
STORAGE_TYPE="local"

# AWS S3 Configuration (if using S3)
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="your-bucket-name"

# ====================================
# Error Tracking (OPTIONAL)
# ====================================
# Sentry DSN for error tracking
# Get from: https://sentry.io
# SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# ====================================
# Analytics (OPTIONAL)
# ====================================
# Google Analytics tracking ID
# ANALYTICS_ID="G-XXXXXXXXXX"

# ====================================
# Feature Flags (OPTIONAL)
# ====================================
# Enable multi-factor authentication
ENABLE_MFA="false"

# Enable email verification for new accounts
ENABLE_EMAIL_VERIFICATION="true"

# Enable audit logging
ENABLE_AUDIT_LOG="true"

# Enable maintenance mode
MAINTENANCE_MODE="false"

# ====================================
# Rate Limiting (OPTIONAL)
# ====================================
# Rate limit for API requests (requests per minute)
API_RATE_LIMIT="100"

# Rate limit for login attempts (attempts per minute)
LOGIN_RATE_LIMIT="5"

# ====================================
# Development/Testing (OPTIONAL)
# ====================================
# Enable debug mode (verbose logging)
DEBUG_MODE="false"

# Skip email sending in development
SKIP_EMAIL="false"

# Seed database with test data
SEED_DATABASE="false"